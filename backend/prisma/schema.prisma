// SprintIQ Prisma schema (ADR-0005).
// One Postgres schema (public); bounded-context separation is LOGICAL via table
// prefixes (@@map). No cross-context foreign keys — references across contexts
// use internal ids resolved through services/events (keeps contexts extractable,
// ADR-0001). Every domain model carries tenantId (row-level tenancy); ids are
// ULIDs generated in app code (newId()).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// BC-2 Identity, Tenancy & Access
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id
  name      String
  plan      String   @default("trial")
  region    String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenant")
}

model User {
  id           String   @id
  tenantId     String
  // Email is globally unique: a user belongs to exactly one tenant, and login
  // resolves the tenant from the user (no tenant id at login) — see ADR-0006.
  email        String   @unique
  displayName  String
  passwordHash String?
  ssoSubject   String?
  roles        String[] @default([])
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@map("identity_user")
}

// ---------------------------------------------------------------------------
// BC-0 Source-System Registry & Connection Health
// ---------------------------------------------------------------------------

model Connection {
  id                String    @id
  tenantId          String
  sourceSystem      String
  name              String
  config            Json
  secretRef         String?
  webhookSecretRef  String?
  syncCursors       Json
  rateLimitState    Json
  status            String    @default("pending")
  // When this connection last *reached* its source. NOT a completeness measure:
  // a connection can talk to GitHub successfully every 5 minutes while still
  // being 80 pages behind in its backfill. Use collectedThroughAt for "is
  // today's data in?" — see METRICS.md §9 data_freshness.
  lastSyncAt        DateTime?
  // The two ends of what this connection has actually collected. Together they
  // answer "is the range this board is showing complete?", which one watermark
  // alone cannot: a board showing the last 7 days over a complete last 7 days
  // is complete, however far a 12-month historical walk still has to go.
  //
  // collectedThroughAt = newest point collected up to (upper bound).
  // collectedBackTo    = oldest point walked to so far (lower bound).
  // A window [from, now] is complete iff collectedBackTo <= from.
  //
  // The sources walk in opposite directions, and both cases are covered:
  // GitHub goes newest-first, so recent data is complete almost immediately
  // and collectedBackTo descends over days; Jira goes oldest-first
  // (ORDER BY updated ASC), so collectedBackTo is the floor at once and
  // collectedThroughAt climbs. Derived from each collector's own cursors,
  // which only it can interpret.
  collectedThroughAt DateTime?
  collectedBackTo    DateTime?
  // Set by an admin "sync now" and cleared the moment the connection actually
  // syncs. A pending flag, not a timestamp comparison: a connection carrying one
  // is due regardless of its interval AND sorts to the head of the sweep, so on
  // a 195-connection tenant "sync now" means next rather than eventually.
  syncRequestedAt   DateTime?
  syncLagSeconds    Int       @default(0)
  // Set once, the first tick the historical backfill (all entity types) fully completes.
  backfillCompletedAt DateTime?
  // Health of the most recent sync pass. A pass that reached the source but was
  // rejected (revoked token, renamed repo, expired page token) still returns
  // zero events, which is indistinguishable from "nothing changed" — so without
  // this a broken connection reports a successful sync and shows as healthy
  // indefinitely. Cleared on the next clean pass.
  lastError         String?
  lastErrorAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([tenantId, sourceSystem])
  // The sweep's query: filter on sourceSystem+status, then order
  // requested-first, then neediest. Declared with the sort directions the
  // query actually uses — see the migration for why a direction-less index
  // cannot serve this ORDER BY.
  @@index([sourceSystem, status, syncRequestedAt(sort: Desc), lastSyncAt])
  @@map("connections_connection")
}

// One row per source system ("github" | "jira"), tracking the live
// tick-in-progress (or last completed tick) state for THAT source's own
// scheduled sweep — persisted (not in-memory) so it survives dev-server
// restarts and works the same across multiple API replicas. GitHub and Jira
// are ticked independently so one source's cadence never blocks the other's.
// Powers the Sync Status screen's per-source "is a tick running right now"
// + rough ETA.
model SchedulerTick {
  sourceSystem         String    @id
  startedAt            DateTime?
  finishedAt           DateTime?
  totalConnections     Int       @default(0)
  connectionsProcessed Int       @default(0)

  @@map("collectors_scheduler_tick")
}

// Tenant-scoped history: one row per connection per tick where that
// connection was actually due (per its own configured
// config.syncIntervalMinutes) and polled — connections skipped as not-yet-due
// get no row. Powers the Sync Status screen's "previous sync + what was
// synced" run history, per connection/source.
model ConnectionSyncRun {
  id             String    @id
  tenantId       String
  connectionId   String
  sourceSystem   String
  startedAt      DateTime
  finishedAt     DateTime?
  eventsFetched  Int       @default(0)
  eventsIngested Int       @default(0)
  status         String    @default("running") // running | success | error
  errorMessage   String?

  @@index([tenantId, sourceSystem, startedAt])
  @@index([tenantId, connectionId, startedAt])
  @@map("collectors_connection_sync_run")
}

// Encrypted, tenant-scoped secret values (BC-0). `ref` matches the human-chosen
// name an admin sets in a `secretRefs` field (e.g. "GITHUB_TOKEN") — SecretsService
// resolves it here first (AES-256-GCM, app-level master key) before falling back
// to `process.env[ref]`, so existing deploy-time env-var setups keep working
// untouched. `ciphertext` never appears in logs or API responses.
model TenantSecret {
  id         String   @id
  tenantId   String
  ref        String
  ciphertext String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, ref])
  @@map("connections_tenant_secret")
}

model TenantConfiguration {
  id         String   @id
  tenantId   String
  namespace  String
  key        String   @default("default")
  values     Json
  secretRefs Json
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, namespace, key])
  @@index([tenantId, namespace])
  @@map("tenant_configuration")
}

// ---------------------------------------------------------------------------
// BC-1 Collectors & Ingestion — append-only, replayable raw-event store
// ---------------------------------------------------------------------------

model RawEvent {
  id               String    @id
  tenantId         String
  connectionId     String
  sourceSystem     String
  collectionMode   String
  eventType        String
  idempotencyKey   String
  occurredAt       DateTime
  collectedAt      DateTime
  envelope         Json
  processingStatus String    @default("received")
  processedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, processingStatus])
  @@map("collectors_raw_event")
}

// ---------------------------------------------------------------------------
// BC-16 Audit & Lineage
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id
  tenantId   String?
  actorType  String
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// BC-3 Planning (Jira domain)
// ---------------------------------------------------------------------------

model Story {
  id               String    @id
  tenantId         String
  connectionId     String
  externalKey      String // e.g. PAY-2231
  projectKey       String
  // story | bug | task | spike | subtask | epic — epics and subtasks are rows
  // in this table so every work-item granularity is queryable (detailing).
  type             String    @default("story")
  status           String
  // Workflow-independent bucket for `status` (Jira's statusCategory key):
  // "new" | "indeterminate" | "done". Status NAMES are per-project and
  // unbounded ("READY FOR ESTIMATION", "ACCEPTED IN UAT", …), so flow metrics
  // classify on this instead of trying to enumerate names per tenant.
  statusCategory   String?
  storyPoints      Int?
  title            String
  // Hierarchy + planning attribution (the "detailing" dimensions):
  epicKey          String? // external key of the parent epic (type='epic' row)
  parentKey        String? // parent story external key (for subtasks)
  sprintExternalId String? // Sprint.externalId this item is committed to
  releases         String[]  @default([]) // Jira fixVersion names
  assigneeLogin    String?
  assigneeName     String?
  /// The assignee's Atlassian account email, when Jira discloses it.
  ///
  /// The strong rung of the Jira↔GitHub identity bridge (DATA-MODEL.md §3.1):
  /// people commit under their corporate address and hold their Atlassian
  /// account under the same one, so an exact match here is worth far more than
  /// the display-name inference it supersedes.
  ///
  /// **Routinely null, and that is not an error.** Jira Cloud omits
  /// `emailAddress` from the assignee object unless the instance's user-profile
  /// visibility permits it (Atlassian's post-2019 GDPR default is to hide it).
  /// Null therefore means "Jira would not tell us", never "this person has no
  /// email" — matching falls back to the name rungs, exactly as before.
  assigneeEmail    String?
  priority         String?
  // When the item was created in JIRA — distinct from `createdAt` below, which
  // is when this row was inserted (i.e. the backfill's run date). lead_time
  // (METRICS.md) is `resolvedAt - sourceCreatedAt`; measuring it from
  // `createdAt` reports the age of our database, not the age of the work.
  // Null for items collected before this field was requested from Jira, until
  // they are re-walked — such items are excluded from lead time, not guessed.
  sourceCreatedAt  DateTime?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([tenantId, externalKey])
  @@index([tenantId, projectKey])
  @@index([tenantId, epicKey])
  @@index([tenantId, sprintExternalId])
  // The identity bridge looks assignees up BY email, so it is a predicate.
  @@index([tenantId, assigneeEmail])
  @@map("planning_story")
}

// Append-only status-transition timeline per work item (`issue_status_history`
// in DATA-MODEL.md). This is the basis for every flow metric — cycle_time,
// wip/wip_age, flow_efficiency, blocked_time and aging_work_items all derive
// from it (METRICS.md), because a story row alone only carries its CURRENT
// status and can't say when it entered one.
//
// Sourced from Jira's changelog, keyed on that changelog entry's own id so a
// re-walk of the same issue is naturally idempotent.
model IssueStatusHistory {
  id             String   @id
  tenantId       String
  connectionId   String
  externalKey    String // e.g. PAY-2231
  // Jira changelog history id — stable per transition, so it de-dupes re-fetches.
  changelogId    String
  // Null for the very first transition (issue creation has no prior status).
  fromStatus     String?
  toStatus       String
  // Workflow-independent buckets for the status names above, resolved from the
  // site's status catalog at collection time. Flow metrics classify on these:
  // status NAMES are per-project and unbounded, so "when did this enter
  // in-progress" is only answerable via the category. Null when the name wasn't
  // in the catalog (a status deleted since the transition happened).
  fromCategory   String?
  toCategory     String?
  transitionedAt DateTime
  authorLogin    String?
  authorName     String?
  createdAt      DateTime @default(now())

  @@unique([tenantId, connectionId, changelogId])
  @@index([tenantId, externalKey, transitionedAt])
  @@map("planning_issue_status_history")
}

// Append-only sprint-membership timeline (`sprint_scope`, DATA-MODEL.md §4) —
// one row per sprint id added to / removed from a work item, from the source's
// own change log. The basis for sprint_commitment_reliability and scope_creep:
// "committed at start" vs "added mid-sprint" is unanswerable from
// Story.sprintExternalId, which only knows CURRENT membership.
//
// A story created directly into a sprint produces no changelog entry, so its
// membership start is inferred at read time: current membership (or a later
// `removed` row) with no matching `added` row means "member since
// Story.sourceCreatedAt".
model SprintScopeChange {
  id               String   @id
  tenantId         String
  connectionId     String
  externalKey      String // work item key, e.g. PAY-2231
  sprintExternalId String // Sprint.externalId this change touches
  action           String // added | removed
  // Jira changelog history id — stable per change, so replays de-dupe. One
  // entry can touch several sprints (a move is one entry: removed A, added B),
  // hence the compound key rather than changelogId alone.
  changelogId      String
  changedAt        DateTime
  authorLogin      String?
  authorName       String?
  createdAt        DateTime @default(now())

  @@unique([tenantId, connectionId, changelogId, sprintExternalId])
  @@index([tenantId, sprintExternalId, changedAt])
  @@index([tenantId, externalKey])
  @@map("planning_sprint_scope_change")
}

model Sprint {
  id           String    @id
  tenantId     String
  connectionId String
  externalId   String // Jira sprint id (as string)
  name         String
  state        String    @default("active") // future | active | closed
  projectKey   String
  startAt      DateTime?
  endAt        DateTime?
  goal         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([tenantId, externalId])
  @@index([tenantId, projectKey, state])
  @@map("planning_sprint")
}

model Release {
  id           String    @id
  tenantId     String
  connectionId String
  name         String // Jira fixVersion name
  projectKey   String
  released     Boolean   @default(false)
  releaseDate  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([tenantId, projectKey, name])
  @@index([tenantId, projectKey])
  @@map("planning_release")
}

// ---------------------------------------------------------------------------
// BC-4 Source Control (Git domain)
// ---------------------------------------------------------------------------

model PullRequest {
  id             String    @id
  tenantId       String
  connectionId   String
  repoFullName   String // e.g. acme/payments
  externalNumber String
  title          String
  branch         String
  baseBranch     String?
  state          String // open | merged | closed
  authorLogin    String?
  additions      Int       @default(0)
  deletions      Int       @default(0)
  changedFiles   Int       @default(0)
  commitMessages String[]  @default([])
  openedAt       DateTime?
  // Derived from the review timeline at collection time: first review of any
  // kind, and the first APPROVED. Both drive the pr_cycle_time sub-phases
  // (METRICS.md §2), which are the part that makes a slow PR actionable.
  firstReviewAt  DateTime?
  approvedAt     DateTime?
  mergedAt       DateTime?
  // Who merged it — `self_merge_rate` is "merged by the author with no
  // non-author approval", so the merger and the approvals are both required.
  mergedBy       String?
  // When this PR's review timeline was last fetched. The discriminator between
  // "genuinely had no reviews" and "we never asked" — those are the same
  // absence of `code_pr_review` rows, and conflating them reports incomplete
  // collection as an alarming self-merge rate. Set even when the fetch found
  // zero reviews, because that is itself an answer.
  reviewsFetchedAt DateTime?
  // When the PR detail endpoint was last fetched for this row. Same purpose as
  // `reviewsFetchedAt`: without it, a PR that GitHub will never fill in — a
  // genuinely empty diff, or one merged by a since-deleted account so
  // `merged_by` is null forever — stays a reconciler candidate permanently.
  // Harmless for a hand-run endpoint; on a schedule it re-fetches those rows
  // every tick, burning the rate limit for eternity.
  detailFetchedAt  DateTime?
  // When this PR's commit subjects were fetched (`GET /pulls/{n}/commits`).
  // Same discriminator as its two siblings: an empty `commitMessages` on a PR
  // collected before 2026-08-12 means "never asked", not "carries no key" —
  // and commit messages are one of the three documented Jira-key sources, so
  // conflating the two silently understates linkage coverage.
  commitsFetchedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, repoFullName, externalNumber])
  @@index([tenantId, repoFullName])
  @@index([tenantId, reviewsFetchedAt])
  @@index([tenantId, detailFetchedAt])
  @@index([tenantId, commitsFetchedAt])
  @@map("code_pull_request")
}

// One submitted review on a pull request (`pr_review` in DATA-MODEL.md) — the
// basis for the whole Review Quality family (METRICS.md §3) and for
// time_to_first_review / review_time / merge_time, none of which are derivable
// from the pull_request row alone.
//
// Keyed on GitHub's own review id so a re-poll of the same PR converges on one
// row instead of duplicating the timeline — the same reasoning as
// issue_status_history's changelog id. Reviews are immutable once submitted,
// so there is nothing to update on conflict.
model PrReview {
  id             String   @id
  tenantId       String
  connectionId   String
  repoFullName   String
  // Denormalized rather than a pull_request FK, matching how every other fact
  // in this schema addresses externals: source ids are VARCHAR, never re-minted.
  externalNumber String
  /// GitHub's review id — stable per review, so re-collection de-dupes.
  externalId     String
  reviewerLogin  String?
  /// Automation, not a person. Recorded at collection time from GitHub's own
  /// `user.type == "Bot"`, falling back to the `name[bot]` login convention.
  /// People metrics (coverage, latency, reviewer load) exclude these — a bot
  /// approving in seconds otherwise flatters both review coverage and review
  /// latency while no human has looked at the change (METRICS.md §0).
  isBot          Boolean  @default(false)
  /// approved | changes_requested | commented | dismissed
  state          String
  /// Inline review comments attributed to this review, from the PR's review-
  /// comments endpoint. Drives review_depth and rubber_stamp_rate.
  commentCount   Int      @default(0)
  /// Whether the comment counts for this PR were actually fetched. Without it,
  /// "reviewed with zero comments" (a rubber stamp) is indistinguishable from
  /// "we never counted", and rubber_stamp_rate would indict every PR collected
  /// before comment counting existed.
  commentsCounted Boolean @default(false)
  /// Whether the review carried a written body — the honest "substantive"
  /// signal available without the comments endpoint.
  hasBody        Boolean  @default(false)
  submittedAt    DateTime
  createdAt      DateTime @default(now())

  @@unique([tenantId, externalId])
  @@index([tenantId, repoFullName, externalNumber])
  @@index([tenantId, reviewerLogin, submittedAt])
  @@index([tenantId, isBot])
  @@map("code_pr_review")
}

model Commit {
  id           String   @id
  tenantId     String
  connectionId String
  repoFullName String
  sha          String
  message      String
  authorLogin  String?
  authorName   String?
  authorEmail  String?
  authoredAt   DateTime
  committedAt  DateTime?
  additions    Int      @default(0)
  deletions    Int      @default(0)
  filesChanged Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, repoFullName, sha])
  @@index([tenantId, authorLogin, authoredAt])
  @@index([tenantId, repoFullName, authoredAt])
  // Commit reads resolve a developer to their git emails too (see
  // DeveloperIdentity), so the email is a query predicate, not just a fact.
  @@index([tenantId, authorEmail, committedAt])
  @@map("code_commit")
}

// ---------------------------------------------------------------------------
// BC-5 Correlation & Delivery Graph
// ---------------------------------------------------------------------------

model CorrelationLink {
  id            String   @id
  tenantId      String
  edgeType      String // e.g. pr_implements_story
  fromType      String
  fromId        String
  toType        String
  toId          String
  confidence    Float
  method        String // regex | heuristic | ml | manual | structural
  evidence      Json?
  sourceEventId String?
  createdAt     DateTime @default(now())

  @@index([tenantId, edgeType])
  @@map("correlation_link")
}

model Orphan {
  id         String    @id
  tenantId   String
  nodeType   String
  nodeRef    String
  reason     String // no_key | ambiguous_key | unknown_project | ambiguous_identity | unresolved_identity
  detectedAt DateTime  @default(now())
  resolvedAt DateTime?

  @@index([tenantId, nodeType])
  @@map("correlation_orphan")
}

/// Identity resolution (DATA-MODEL.md §3): maps the many source identities one
/// human commits under to a single canonical developer.
///
/// This exists because a git identity and a GitHub account are not the same
/// thing. GitHub only fills `commit.author.login` when the commit's email is a
/// VERIFIED email on some account; otherwise the commit arrives carrying a name
/// and email and no login at all, while that same person's pull requests always
/// carry `user.login`. Querying commits by raw login therefore returns nothing
/// for them, and the dashboards report "0 commits" as if it were a fact about
/// the person rather than an artefact of email configuration.
///
/// One row per observed SOURCE identity; `canonicalDeveloperId` is what the
/// read models group by. Links carry `confidence` and `method`, and ambiguous
/// matches are queued as orphans rather than silently merged (DATA-MODEL.md §3,
/// CLAUDE.md "correlation is the moat").
model DeveloperIdentity {
  id           String   @id
  tenantId     String
  sourceSystem String // github | jira | sso
  /// Stable key for the observed identity: "login:<login>" when the source
  /// resolved an account, else "email:<lowercased email>".
  sourceKey    String
  sourceLogin  String?
  email        String?
  name         String?
  /// The developer all of this person's identities roll up to — the source
  /// login when one is known, else the `email:` key. Read models group by this.
  canonicalDeveloperId String
  confidence   Float
  method       String // github_login | email_exact | name_normalized | unresolved
  /// Evidence for the link, so any attribution can be explained and audited.
  evidence     Json?
  linkedUserId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, sourceSystem, sourceKey])
  @@index([tenantId, canonicalDeveloperId])
  @@map("correlation_developer_identity")
}

/// A developer deliberately kept off the Watchlist's attention buckets.
///
/// The Watchlist reports who has shown no tracked signal lately. That question
/// has ordinary answers the platform cannot see — approved leave, a new joiner
/// who has not landed a first commit, a secondment, a sabbatical — and every
/// one of them renders identically to disengagement. SprintIQ has no HR feed
/// and will not infer one, so the exclusion is an explicit human statement
/// entered by an admin, not a derived fact.
///
/// Deliberately NOT a soft delete: an excluded developer keeps counting in
/// every commit, PR and metric figure. The exclusion suppresses one thing —
/// being listed as someone to go ask about — and the board still discloses the
/// count and the reasons, because a silently shortened list is how a roster
/// review loses the person it should have surfaced.
model WatchlistExclusion {
  id                   String    @id
  tenantId             String
  /// The developer this covers, as `DeveloperIdentity.canonicalDeveloperId`.
  canonicalDeveloperId String
  /// leave | new_joiner | secondment | other — shown on the board, never blank.
  reason               String
  /// Free-text context for the reason. Displayed to admins only.
  note                 String?
  /// When the exclusion lapses. Required: an exclusion with no end date is how
  /// someone drops off the roster permanently without anyone deciding to.
  expiresAt            DateTime
  /// Who entered it — this is a human judgement and it carries a name.
  createdByUserId      String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  /// One live exclusion per developer; re-excluding updates the existing row.
  @@unique([tenantId, canonicalDeveloperId])
  @@index([tenantId, expiresAt])
  @@map("watchlist_exclusion")
}

// ---------------------------------------------------------------------------
// BC-8 Metrics & Aggregation
// ---------------------------------------------------------------------------

model MetricValue {
  id          String   @id
  tenantId    String
  metricKey   String
  scopeType   String // developer | team | repo | project | org | sprint
  scopeId     String
  periodStart DateTime
  periodEnd   DateTime
  value       Float
  sampleSize  Int      @default(0)
  lineage     Json?
  computedAt  DateTime @default(now())

  @@index([tenantId, metricKey, scopeType, scopeId])
  @@map("metrics_value")
}
