# ---- Process role: api | collector | worker (see docs/deployment/README.md §1) ----
APP_ROLE=api
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ---- Database (PostgreSQL + pgvector) — consumed by Prisma ----
DATABASE_URL=postgresql://sprintiq:sprintiq@localhost:5432/sprintiq?schema=public

# ---- Redis (queues, poll scheduling, rate-limit state, cache) ----
REDIS_URL=redis://localhost:6379

# ---- Auth (BC-2) ----
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=3600s
# Platform bootstrap token to provision the first tenant + admin (POST /api/admin/tenants).
PROVISIONING_TOKEN=dev-provision-token

# ---- Collectors / integration (BC-0/BC-1) ----
# Base URL used when registering source webhooks (e.g. https://hooks.sprintiq.io)
PUBLIC_WEBHOOK_BASE_URL=http://localhost:3000
# Secret store provider for source credentials & webhook secrets: env | vault | aws-kms | gcp-sm
SECRETS_PROVIDER=env
# Webhook signing secret for the seeded GitHub connection (referenced by webhookSecretRef).
GITHUB_WEBHOOK_SECRET=dev-webhook-secret
# Master key for the DB-backed encrypted secret store (SecretsService) — lets an
# admin paste a real GitHub/Jira token into admin/configuration instead of
# setting a deploy-time env var. AES-256-GCM, so this must base64-decode to
# exactly 32 bytes. Generate with: openssl rand -base64 32
# Leave unset to disable pasting secrets in the UI (env-var refs still work).
SECRETS_ENCRYPTION_KEY=
# GitHub collection transport: rest | graphql (ADR-0008, api/README.md §3).
# REST costs 4 API calls per PR and 1 per commit, so a 195-repo fleet needs
# ~24,765 calls against a 5,000/hour limit; GraphQL returns a fully-enriched
# page for ~1 point, on its own separate quota. Default is rest: do NOT switch
# a deployment holding REST-collected history until
# `npx ts-node scripts/github-graphql-parity.ts <owner/repo>` reports no
# critical differences — that check needs the REST data to compare against.
GITHUB_COLLECTION_MODE=rest
# How much further one tick's enrich budget stretches under GraphQL, where a
# page arrives pre-enriched. Bounds tick duration, not quota. (default 4)
GITHUB_GRAPHQL_ENRICH_MULTIPLIER=4
# API calls the reconcilers refuse to spend, so backfill cannot drain the hour's
# quota out from under the scheduled sync — the thing users are actually waiting
# on — while it catches up over hours. Raise it if incremental collection is
# being starved; lower it to let a first backfill finish sooner. (default 1000)
GITHUB_BACKFILL_RATE_RESERVE=1000

# ---- Collector scheduling ----
# How many connections one sweep polls at once. Deliberately small: the point is
# to stop wall-clock being the binding constraint on a large fleet, not to
# maximise throughput — API spend is bounded by the per-sweep budget either way,
# and every connection still writes its own rows. (default 4)
COLLECTOR_SWEEP_CONCURRENCY=4
# Hour (IST, 0-23) of the day-close pass, which queues every active connection
# so the day's data is collected before the date rolls over. 22:00 is late
# enough to capture the working day and leaves roughly two hours of headroom for
# an org-scale sweep to finish. Tunable per deployment, since how long a sweep
# takes depends on how many connections it runs. (default 22)
DAY_CLOSE_HOUR_IST=22

# ---- AI (BC-11) ----
LLM_API_KEY=
LLM_DEFAULT_MODEL=claude-opus-4-8
